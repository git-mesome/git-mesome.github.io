---
import { getCollection } from "astro:content";
import { basicInfo } from "../data/resume.ts";
import { groupPortfolioEntries } from "../lib/portfolioGroups.ts";

const currentPath = Astro.url.pathname;
const isPortfolioActive = currentPath.startsWith("/portfolio");

const portfolioEntries = await getCollection("portfolio");
const portfolioGroups = groupPortfolioEntries(portfolioEntries);

const MOON_ICON =
  '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
const PRINTER_ICON =
  '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>';
const MEDIUM_ICON =
  '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 100 100"><rect width="100" height="100" rx="22" fill="#000"/><circle cx="34" cy="50" r="20" fill="#fff"/><ellipse cx="66" cy="50" rx="9" ry="20" fill="#fff"/><ellipse cx="85" cy="50" rx="3.5" ry="20" fill="#fff"/></svg>';

const BLOG_URL = "https://medium.com/@minseo-kim";
---

<aside class="sidebar">
    <div class="sidebar-inner">
      <a class="brand" href="/">
        <strong>{basicInfo.name}</strong>
        <span class="tagline">{basicInfo.tagline}</span>
      </a>

      <nav aria-label="주 메뉴">
        <ul class="nav-list">
          <li>
            <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>
              <span class="chevron" aria-hidden="true">›</span>
              Resume
            </a>
          </li>
          <li>
            <details class="portfolio-group" open={isPortfolioActive}>
              <summary>
                <a href="/portfolio" aria-current={currentPath === "/portfolio" ? "page" : undefined}>
                  <span class="chevron" aria-hidden="true">›</span>
                  Portfolio
                </a>
              </summary>
              <div class="tree">
                {
                  portfolioGroups.map((group) => (
                    <div class="company-group">
                      {group.company && <p class="company-name">{group.company}</p>}
                      <ul>
                        {group.projects.map((item) => {
                          const href = `/portfolio/${item.id}`;
                          const isActive = currentPath === href;
                          return (
                            <li>
                              <a href={href} aria-current={isActive ? "page" : undefined}>{item.data.title}</a>
                            </li>
                          );
                        })}
                      </ul>
                      {group.troubleshooting.length > 0 && (
                        <>
                          <p class="section-label">Troubleshooting</p>
                          <ul>
                            {group.troubleshooting.map((item) => {
                              const href = `/portfolio/${item.id}`;
                              const isActive = currentPath === href;
                              return (
                                <li>
                                  <a href={href} aria-current={isActive ? "page" : undefined}>
                                    {item.data.title}
                                  </a>
                                </li>
                              );
                            })}
                          </ul>
                        </>
                      )}
                    </div>
                  ))
                }
              </div>
            </details>
          </li>
          <li>
            <a href="/books" aria-current={currentPath.startsWith("/books") ? "page" : undefined}>
              <span class="chevron" aria-hidden="true">›</span>
              Books
            </a>
          </li>
          <li>
            <a href={BLOG_URL} target="_blank" rel="noopener noreferrer">
              <span class="icon" aria-hidden="true" set:html={MEDIUM_ICON} />
              Blog
            </a>
          </li>
        </ul>
      </nav>

      <div class="sidebar-footer">
        <button type="button" id="theme-toggle" class="icon-button" aria-label="다크모드 전환">
          <span id="theme-toggle-icon" class="icon" aria-hidden="true" set:html={MOON_ICON} />
        </button>
        <button type="button" id="print-button" class="icon-button" aria-label="인쇄">
          <span class="icon" aria-hidden="true" set:html={PRINTER_ICON} />
        </button>
      </div>
    </div>
</aside>

<script>
  const STORAGE_KEY = "theme";
  const MOON_ICON =
    '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
  const SUN_ICON =
    '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';

  const root = document.documentElement;
  const button = document.getElementById("theme-toggle");
  const icon = document.getElementById("theme-toggle-icon");
  const printButton = document.getElementById("print-button");

  function effectiveTheme(): "light" | "dark" {
    const attr = root.getAttribute("data-theme");
    if (attr === "light" || attr === "dark") return attr;
    return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function syncButton() {
    const theme = effectiveTheme();
    if (icon) icon.innerHTML = theme === "dark" ? SUN_ICON : MOON_ICON;
    button?.setAttribute("aria-label", theme === "dark" ? "라이트모드로 전환" : "다크모드로 전환");
  }

  button?.addEventListener("click", () => {
    const next = effectiveTheme() === "dark" ? "light" : "dark";
    localStorage.setItem(STORAGE_KEY, next);
    root.setAttribute("data-theme", next);
    syncButton();
  });

  printButton?.addEventListener("click", () => window.print());

  syncButton();
</script>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 1.5rem;
    padding: 20px 24px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    color: var(--color-fg);
    text-decoration: none;
  }

  .brand strong {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .brand .tagline {
    color: var(--color-subtle);
    font-family: var(--font-mono);
    font-size: 14.5px;
    margin-top: 2px;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-list > li > a {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-fg);
    text-decoration: none;
    padding: 0.4rem 0;
    font-weight: 400;
  }

  .nav-list > li > a .icon {
    display: inline-flex;
    color: var(--color-muted);
  }

  .nav-list > li > a[aria-current="page"] {
    color: var(--color-accent);
    font-weight: 700;
  }

  .chevron {
    color: var(--color-muted);
    font-weight: 700;
  }

  a[aria-current="page"] .chevron {
    color: var(--color-accent);
  }

  .portfolio-group summary {
    list-style: none;
    padding: 0;
  }

  .portfolio-group summary::-webkit-details-marker {
    display: none;
  }

  .portfolio-group > summary > a {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-fg);
    text-decoration: none;
    padding: 0.4rem 0;
    font-weight: 400;
  }

  .portfolio-group > summary > a[aria-current="page"] {
    color: var(--color-accent);
    font-weight: 700;
  }

  .tree {
    padding-left: 0.75rem;
    border-left: 1px solid var(--color-border);
    margin-left: 0.25rem;
  }

  .company-group {
    margin-block: 0.75rem;
  }

  .company-name {
    font-size: 14.5px;
    color: var(--color-muted);
    margin: 0 0 0.35rem;
  }

  .company-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .section-label {
    margin: 0.75rem 0 0.35rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--color-border);
    font-size: 0.7rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .company-group a {
    color: var(--color-fg);
    text-decoration: none;
    font-size: 12px;
  }

  .company-group a[aria-current="page"] {
    color: var(--color-accent);
    font-weight: 600;
  }

  .sidebar-footer {
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
  }

  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-muted);
    cursor: pointer;
  }

  .icon-button:hover {
    color: var(--color-fg);
    border-color: var(--color-fg);
  }

  .icon-button .icon {
    display: inline-flex;
  }

  @media print {
    .sidebar {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .sidebar {
      flex: 0 0 315px;
      border-bottom: none;
      border-right: 1px solid var(--color-border);
      height: 100vh;
      position: sticky;
      top: 0;
      overflow-y: auto;
    }

    .sidebar-inner {
      padding: 56px 32px;
    }
  }
</style>
