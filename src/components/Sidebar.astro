---
import { getCollection } from "astro:content";
import { basicInfo } from "../data/resume.ts";
import { groupPortfolioEntries } from "../lib/portfolioGroups.ts";

const currentPath = Astro.url.pathname;
const isPortfolioActive = currentPath.startsWith("/portfolio");

const portfolioEntries = await getCollection("portfolio");
const portfolioGroups = groupPortfolioEntries(portfolioEntries);

const MOON_ICON =
  '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
const PRINTER_ICON =
  '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>';
const MEDIUM_ICON =
  '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 100 100"><rect width="100" height="100" rx="22" fill="#000"/><circle cx="34" cy="50" r="20" fill="#fff"/><ellipse cx="66" cy="50" rx="9" ry="20" fill="#fff"/><ellipse cx="85" cy="50" rx="3.5" ry="20" fill="#fff"/></svg>';

const BLOG_URL = "https://medium.com/@minseo-kim";
---

<aside class="sidebar">
    <div class="sidebar-inner">
      <a class="brand" href="/">
        <strong>{basicInfo.name}</strong>
        <span class="tagline">{basicInfo.tagline}</span>
      </a>

      <nav aria-label="주 메뉴">
        <ul class="nav-list">
          <li>
            <a class="nav-link" href="/" aria-current={currentPath === "/" ? "page" : undefined}>
              <span class="nav-marker" aria-hidden="true">›</span>
              Resume
            </a>
          </li>
          <li>
            <details class="nav-tree" open={isPortfolioActive}>
              <summary class="nav-summary">
                <a class="nav-link" href="/portfolio" aria-current={currentPath === "/portfolio" ? "page" : undefined}>
                  <span class="nav-marker nav-marker-toggle" aria-hidden="true">›</span>
                  <span class="nav-summary-link">Portfolio</span>
                </a>
              </summary>
              <ul class="nav-tree-list">
                {
                  portfolioGroups.map((group) => {
                    const items = (
                      <ul class="nav-tree-items">
                        {group.projects.length > 0 && (group.troubleshooting.length > 0 || group.practice.length > 0) && (
                          <li class="nav-tree-label-row">
                            <p class="nav-tree-label">기획 · 설계 판단</p>
                          </li>
                        )}
                        {group.projects.map((item) => {
                          const href = `/portfolio/${item.id}`;
                          const isActive = currentPath === href;
                          return (
                            <li>
                              <a class="nav-tree-item" href={href} aria-current={isActive ? "page" : undefined}>
                                {item.data.title}
                              </a>
                            </li>
                          );
                        })}
                        {group.troubleshooting.length > 0 && (
                          <li class="nav-tree-troubleshooting">
                            <p class="nav-tree-label">트러블슈팅</p>
                            <ul>
                              {group.troubleshooting.map((item) => {
                                const href = `/portfolio/${item.id}`;
                                const isActive = currentPath === href;
                                return (
                                  <li>
                                    <a class="nav-tree-item" href={href} aria-current={isActive ? "page" : undefined}>
                                      {item.data.title}
                                    </a>
                                  </li>
                                );
                              })}
                            </ul>
                          </li>
                        )}
                        {group.practice.length > 0 && (
                          <li class="nav-tree-practice">
                            <p class="nav-tree-label">일하는 방식</p>
                            <ul>
                              {group.practice.map((item) => {
                                const href = `/portfolio/${item.id}`;
                                const isActive = currentPath === href;
                                return (
                                  <li>
                                    <a class="nav-tree-item" href={href} aria-current={isActive ? "page" : undefined}>
                                      {item.data.title}
                                    </a>
                                  </li>
                                );
                              })}
                            </ul>
                          </li>
                        )}
                      </ul>
                    );

                    return (
                      <li>
                        {group.company ? (
                          <details open>
                            <summary class="nav-tree-section">
                              <span class="nav-tree-caret" aria-hidden="true">▾</span>
                              {group.company}
                            </summary>
                            {items}
                          </details>
                        ) : (
                          items
                        )}
                      </li>
                    );
                  })
                }
              </ul>
            </details>
          </li>
          <li>
            <a class="nav-link" href="/books" aria-current={currentPath.startsWith("/books") ? "page" : undefined}>
              <span class="nav-marker" aria-hidden="true">›</span>
              Books
            </a>
          </li>
          <li>
            <a class="nav-link nav-link-external" href={BLOG_URL} target="_blank" rel="noopener noreferrer">
              <span class="nav-icon" aria-hidden="true" set:html={MEDIUM_ICON} />
              Blog
            </a>
          </li>
        </ul>
      </nav>

      <div class="sidebar-footer">
        <button type="button" id="theme-toggle" class="icon-button" aria-label="다크모드 전환">
          <span id="theme-toggle-icon" class="icon" aria-hidden="true" set:html={MOON_ICON} />
        </button>
        <button type="button" id="print-button" class="icon-button" aria-label="인쇄">
          <span class="icon" aria-hidden="true" set:html={PRINTER_ICON} />
        </button>
      </div>
    </div>
</aside>

<script>
  const STORAGE_KEY = "theme";
  const MOON_ICON =
    '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
  const SUN_ICON =
    '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';

  const root = document.documentElement;
  const button = document.getElementById("theme-toggle");
  const icon = document.getElementById("theme-toggle-icon");
  const printButton = document.getElementById("print-button");

  function effectiveTheme(): "light" | "dark" {
    const attr = root.getAttribute("data-theme");
    if (attr === "light" || attr === "dark") return attr;
    return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function syncButton() {
    const theme = effectiveTheme();
    if (icon) icon.innerHTML = theme === "dark" ? SUN_ICON : MOON_ICON;
    button?.setAttribute("aria-label", theme === "dark" ? "라이트모드로 전환" : "다크모드로 전환");
  }

  button?.addEventListener("click", () => {
    const next = effectiveTheme() === "dark" ? "light" : "dark";
    localStorage.setItem(STORAGE_KEY, next);
    root.setAttribute("data-theme", next);
    syncButton();
  });

  printButton?.addEventListener("click", () => window.print());

  syncButton();
</script>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 1.5rem;
    padding: 20px 24px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    color: var(--color-fg);
    text-decoration: none;
  }

  .brand strong {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .brand .tagline {
    color: var(--color-subtle);
    font-family: var(--font-mono);
    font-size: 14.5px;
    margin-top: 2px;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-link {
    display: grid;
    grid-template-columns: 14px 1fr;
    column-gap: 8px;
    align-items: baseline;
    padding: 6px 10px 6px 0;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-fg);
  }

  .nav-link[aria-current="page"] {
    color: var(--color-accent);
    font-weight: 600;
  }

  .nav-summary-link,
  .nav-summary-link:hover {
    color: inherit;
  }

  .nav-marker {
    color: transparent;
    font-weight: 700;
    transform: translateY(-1px);
    transition: color 0.15s ease;
  }

  .nav-link:hover .nav-marker {
    color: var(--color-subtle);
  }

  .nav-link[aria-current="page"] .nav-marker {
    color: var(--color-accent);
  }

  .nav-marker-toggle {
    color: var(--color-subtle);
    transition:
      transform 0.15s ease,
      color 0.15s ease;
  }

  .nav-tree[open] > summary .nav-marker-toggle {
    transform: translateY(-1px) rotate(90deg);
  }

  .nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    color: var(--color-subtle);
    transform: translateY(2px);
    transition: color 0.15s ease;
  }

  .nav-link-external:hover .nav-icon {
    color: var(--color-fg);
  }

  .nav-tree > summary {
    cursor: pointer;
    list-style: none;
  }

  .nav-tree > summary::-webkit-details-marker {
    display: none;
  }

  .nav-tree-list {
    list-style: none;
    margin: 4px 0 0 5px;
    padding-left: 14px;
    border-left: 1px solid var(--color-border);
  }

  .nav-tree-list > li + li {
    margin-top: 4px;
  }

  .nav-tree-section {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px 4px 0;
    font-size: 14.5px;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }

  .nav-tree-section::-webkit-details-marker {
    display: none;
  }

  .nav-tree-section:hover {
    color: var(--color-fg);
  }

  .nav-tree-caret {
    display: inline-block;
    width: 10px;
    font-size: 9px;
    color: var(--color-subtle);
    transition: transform 0.15s ease;
  }

  details:not([open]) > .nav-tree-section .nav-tree-caret {
    transform: rotate(-90deg);
  }

  .nav-tree-items {
    margin: 2px 0 0;
    padding-left: 16px;
    list-style: none;
  }

  .nav-tree-items > li + li {
    margin-top: 1px;
  }

  .nav-tree-item {
    display: block;
    font-size: 12px;
    line-height: 1.45;
    color: var(--color-subtle);
    text-decoration: none;
    border-left: 2px solid transparent;
    padding: 4px 8px;
    margin-left: -8px;
    transition: color 0.15s ease;
  }

  .nav-tree-item:hover {
    color: var(--color-muted);
  }

  .nav-tree-item[aria-current="page"] {
    color: var(--color-accent);
    font-weight: 600;
    border-left-color: var(--color-accent);
  }

  .nav-tree-label-row {
    margin: 0;
  }

  .nav-tree-troubleshooting,
  .nav-tree-practice {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px dashed var(--color-border);
  }

  .nav-tree-troubleshooting > ul,
  .nav-tree-practice > ul {
    list-style: none;
    padding-left: 0;
  }

  .nav-tree-label {
    margin: 0 0 3px;
    padding-left: 0;
    font-size: 10px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-subtle);
    font-weight: 600;
  }

  .sidebar-footer {
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
  }

  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-muted);
    cursor: pointer;
  }

  .icon-button:hover {
    color: var(--color-fg);
    border-color: var(--color-fg);
  }

  .icon-button .icon {
    display: inline-flex;
  }

  @media print {
    .sidebar {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .sidebar {
      flex: 0 0 315px;
      border-bottom: none;
      border-right: 1px solid var(--color-border);
      height: 100vh;
      position: sticky;
      top: 0;
      overflow-y: auto;
    }

    .sidebar-inner {
      padding: 56px 32px;
    }
  }
</style>
