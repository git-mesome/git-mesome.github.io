---
import { getCollection } from "astro:content";
import BookDetailPage from "../../components/pages/BookDetailPage.astro";
import { splitLocaleId } from "../../lib/i18n.ts";

export async function getStaticPaths() {
  const books = await getCollection(
    "books",
    (book) => book.data.featured && splitLocaleId(book.id).lang === "ko"
  );
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book },
  }));
}

const { book } = Astro.props;
---

<BookDetailPage book={book} />
