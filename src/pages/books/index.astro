---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allBooks = (await getCollection("books")).sort(
  (a, b) => b.data.readDate.valueOf() - a.data.readDate.valueOf()
);

// 추천 도서: 각 책 파일 frontmatter의 featured: true 로 직접 고름 (여기만 손보면 됨)
const featuredBooks = allBooks.filter((book) => book.data.featured);

const booksByYear = new Map<number, typeof allBooks>();
for (const book of allBooks) {
  const year = book.data.readDate.getFullYear();
  const list = booksByYear.get(year) ?? [];
  list.push(book);
  booksByYear.set(year, list);
}
const years = [...booksByYear.keys()].sort((a, b) => b - a);
---

<Layout title="Books" description="읽은 책 목록과 추천 도서">
  <h1>Books</h1>

  {
    featuredBooks.length > 0 && (
      <section class="featured">
        <h2>추천하고 싶은 책</h2>
        <div class="featured-grid">
          {featuredBooks.map((book) => (
            <a href={`/books/${book.id}`} class="featured-card">
              {book.data.cover ? (
                <img src={book.data.cover} alt={`${book.data.title} 표지`} />
              ) : (
                <div class="cover-placeholder" aria-hidden="true">
                  [TODO-이미지]
                </div>
              )}
              <div>
                <p class="title-line">
                  <strong>{book.data.title}</strong> <span class="author">{book.data.author}</span>
                </p>
                <p class="blurb">{book.data.blurb ?? "[TODO] 짧은 리뷰"}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="archive">
    {
      years.map((year) => (
        <div class="year-group">
          <h2 class="year-divider">{year}</h2>
          <div class="cover-grid">
            {booksByYear.get(year)!.map((book) => (
              <a href={`/books/${book.id}`} class="cover-link" title={book.data.title}>
                {book.data.cover ? (
                  <img src={book.data.cover} alt={`${book.data.title} 표지`} />
                ) : (
                  <div class="cover-placeholder" aria-hidden="true">
                    [TODO-이미지]
                  </div>
                )}
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</Layout>

<style>
  h1 {
    margin-block-end: 2rem;
  }

  .featured {
    margin-block-end: 3rem;
  }

  .featured h2 {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.4rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 1rem;
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--color-fg);
    text-decoration: none;
  }

  .featured-card img,
  .featured-card .cover-placeholder {
    width: 100%;
  }

  .title-line {
    margin: 0;
    font-size: 16px;
  }

  .title-line strong {
    font-weight: 600;
  }

  .title-line .author {
    font-weight: 400;
    font-size: 14px;
  }

  .blurb {
    font-size: 14px;
    margin: 0.3rem 0 0;
  }

  .year-group {
    margin-block-end: 2.5rem;
  }

  .year-divider {
    color: var(--color-subtle);
    font-family: var(--font-mono);
    font-size: 17px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.4rem;
  }

  .cover-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .cover-link {
    display: block;
  }

  img,
  .cover-placeholder {
    aspect-ratio: 2 / 3;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  img {
    width: 100%;
    object-fit: cover;
  }

  .cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.5rem;
    font-size: 12px;
    color: var(--color-muted);
    background: var(--color-bg-elev);
  }

  .author {
    color: var(--color-muted);
    margin: 0;
  }
</style>
