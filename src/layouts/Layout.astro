---
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";
import { getLang, ui, otherLangHref } from "../lib/i18n.ts";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const lang = getLang(Astro.currentLocale);
const s = ui[lang];
const { description = s.defaultDescription, ogImage } = Astro.props;

// 브라우저 탭 제목은 언어별로 통일 (페이지마다 달라지지 않음)
const pageTitle = s.pageTitle;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : undefined;
const alternateHref = new URL(otherLangHref(lang, Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={lang === "en" ? "ko" : "en"} href={alternateHref} />
    <link rel="alternate" hreflang="x-default" href={lang === "en" ? alternateHref : canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content={ogImageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (function () {
        var theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.setAttribute("data-theme", theme);
        }
      })();
    </script>
    <script is:inline define:vars={{ printTitle: s.printTitle, tabTitle: pageTitle }}>
      window.addEventListener("beforeprint", function () {
        document.title = printTitle;
      });
      window.addEventListener("afterprint", function () {
        document.title = tabTitle;
      });
    </script>
  </head>
  <body>
    <div class="page">
      <Sidebar />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    padding: 40px 24px;
    max-width: 1280px;
  }

  @media (min-width: 768px) {
    .page {
      flex-direction: row;
      max-width: 1560px;
      margin: 0 auto;
    }

    main {
      padding: 64px 48px 64px 56px;
    }
  }

  @media print {
    .page {
      max-width: none !important;
      margin: 0 !important;
    }

    main {
      padding: 0 !important;
      max-width: none !important;
    }
  }
</style>
